<%- include("../../views/partials/admin/header") %>

    <head>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@10/dist/sweetalert2.min.css" />
        <link rel="stylesheet" href="/admin-assets/css/productsCategory.css">
        <style>
            #expireOn {
                cursor: pointer;
            }
        </style>
    </head>

    <body>
        <div class="container">
            <h1 class="d-flex justify-content-center align-content-center py-5">Add New Coupon</h1>
            <form id="couponForm" class="d-block justify-content-center align-content-center p-5 mx-5">
                <div class="form-group">
                    <label for="code">Coupon Code:</label>
                    <input type="text" name="code" id="code" class="form-control shadow" required>
                </div>

                <div class="form-group">
                    <label for="expireOn">Expire On:</label>
                    <input type="date" name="expireOn" id="expireOn" class="form-control shadow" required
                        onclick="this.showPicker()">
                </div>

                <div class="form-group">
                    <label for="offerPrice">Offer Price:</label>
                    <input type="number" name="offerPrice" id="offerPrice" class="form-control shadow" required>
                </div>

                <div class="form-group">
                    <label for="minimumPrice">Minimum Price:</label>
                    <input type="number" name="minimumPrice" id="minimumPrice" class="form-control shadow" required>
                </div>

                <button type="submit" class="btn btn-primary">Add Coupon</button>
            </form>
        </div>

        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const dateInput = document.getElementById('expireOn');
                const today = new Date().toISOString().split('T')[0];
                dateInput.setAttribute('min', today);

                const Toast = Swal.mixin({
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true,
                    didOpen: (toast) => {
                        toast.addEventListener('mouseenter', Swal.stopTimer)
                        toast.addEventListener('mouseleave', Swal.resumeTimer)
                    }
                });

                const form = document.getElementById('couponForm');

                form.addEventListener('submit', function (event) {
                    event.preventDefault();

                    const offerPrice = parseFloat(document.getElementById('offerPrice').value);
                    const minimumPrice = parseFloat(document.getElementById('minimumPrice').value);
                    const expireDateVal = document.getElementById('expireOn').value;
                    const selectedDate = new Date(expireDateVal);
                    const currentDate = new Date();

                    currentDate.setHours(0, 0, 0, 0);

                    let isValid = true;
                    let errorMessage = "";

                    if (offerPrice < 0 || minimumPrice < 0) {
                        isValid = false;
                        errorMessage = "Prices cannot be negative values.";
                    }

                    else if (offerPrice >= minimumPrice) {
                        isValid = false;
                        errorMessage = "Offer Price must be less than the Minimum Price.";
                    }

                    else if (selectedDate < currentDate) {
                        isValid = false;
                        errorMessage = "Expiration date cannot be in the past.";
                    }

                    if (isValid) {
                        createCoupon();
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Validation Error',
                            text: errorMessage,
                        });
                    }
                });

                async function createCoupon() {
                    const formData = new FormData(form);
                    const data = Object.fromEntries(formData.entries()); 
                    console.log('api data',data)

                    try {
                        const response = await fetch('/admin/addCoupon', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify(data)
                        });

                        const result = await response.json();
                        console.log('result',result)

                        if (result.success) {
                            Toast.fire({
                                icon: 'success',
                                title: 'Coupon created successfully'
                            }).then(() => {
                                window.location.href = '/admin/coupons';
                            });
                        } else {
                            Toast.fire({
                                icon: 'error',
                                title: result.message || 'Error creating coupon'
                            });
                        }

                    } catch (error) {
                        console.error('Error:', error);
                        Toast.fire({
                            icon: 'error',
                            title: 'Something went wrong!'
                        });
                    }
                }
            });
        </script>

        <%- include("../../views/partials/admin/footer") %>